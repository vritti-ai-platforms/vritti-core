{
  "name": "gitea-mf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --path=/gitea-mf -- rsbuild dev",
    "dev:dev": "infisical run --env=dev-local --path=/gitea-mf -- rsbuild dev",
    "dev:apw1": "infisical run --env=apw1-local --path=/gitea-mf -- rsbuild dev",
    "dev:ssl": "USE_HTTPS=true rsbuild dev",
    "dev:ssl:vm": "USE_HTTPS=true rsbuild dev --host 0.0.0.0",
    "dev:ssl:w": "cross-env USE_HTTPS=true rsbuild dev",
    "build": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit",
    "preview": "rsbuild preview",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@module-federation/enhanced": "^2.4.0",
    "@module-federation/rsbuild-plugin": "^2.4.0",
    "@module-federation/runtime": "^2.4.0",
    "@tanstack/react-query": "^5.100.10",
    "@vritti/gitea-permissions": "workspace:*",
    "@vritti/quantum-ui": "0.3.24",
    "axios": "^1.13.2",
    "lucide-react": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@rsbuild/core": "2.0.6",
    "@rsbuild/plugin-react": "2.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
