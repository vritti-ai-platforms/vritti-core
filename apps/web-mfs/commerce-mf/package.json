{
  "name": "commerce-mf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "dev": "infisical run --path=/commerce-mf -- rsbuild dev",
    "dev:dev": "infisical run --env=dev-local --path=/commerce-mf -- rsbuild dev",
    "dev:apw1": "infisical run --env=apw1-local --path=/commerce-mf -- rsbuild dev",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "@module-federation/enhanced": "^2.9.3",
    "@module-federation/rsbuild-plugin": "^2.9.3",
    "@module-federation/runtime": "^2.9.3",
    "@tanstack/react-query": "5.104.0",
    "@vritti/commerce-permissions": "workspace:*",
    "@vritti/quantum-ui": "0.6.4",
    "axios": "^1.21.0",
    "lucide-react": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.87.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@rsbuild/core": "2.0.6",
    "@rsbuild/plugin-react": "2.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
