{
  "name": "vritti-core-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "docker compose -f local-db-compose.yml up -d && infisical run --path=/core-server -- nest start",
    "dev": "docker compose -f local-db-compose.yml up -d && infisical run --path=/core-server -- nest start --watch",
    "dev:dev": "docker compose -f local-db-compose.yml up -d redis nats && infisical run --env=dev-local --path=/core-server -- nest start --watch",
    "dev:prod": "docker compose -f local-db-compose.yml up -d redis nats && infisical run --env=apw1-local --path=/core-server -- nest start --watch",
    "debug": "docker compose -f local-db-compose.yml up -d && infisical run --path=/core-server -- nest start --debug --watch",
    "prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "infisical run --path=/core-server -- drizzle-kit generate --name v$npm_package_version",
    "db:generate:custom": "infisical run --path=/core-server -- drizzle-kit generate --custom --name",
    "db:migrate": "docker compose -f local-db-compose.yml up -d postgres && infisical run --path=/core-server -- drizzle-kit migrate",
    "db:migrate:dev": "infisical run --env=dev-local --path=/core-server -- drizzle-kit migrate",
    "db:migrate:prod": "infisical run --env=apw1-local --path=/core-server -- drizzle-kit migrate",
    "db:deploy": "node dist/db/migrate.js",
    "db:studio": "docker compose -f local-db-compose.yml up -d postgres && infisical run --path=/core-server -- drizzle-kit studio",
    "db:studio:dev": "infisical run --env=dev-local --path=/core-server -- drizzle-kit studio",
    "db:studio:prod": "infisical run --env=apw1-local --path=/core-server -- drizzle-kit studio",
    "db:start": "docker compose -f local-db-compose.yml up -d",
    "db:stop": "docker compose -f local-db-compose.yml down",
    "db:tunnel:dev": "cloudflared access tcp --hostname devdb.vrittiai.com --url localhost:6000",
    "db:tunnel:prod": "cloudflared access tcp --hostname apw1db.vrittiai.com --url localhost:5432",
    "gitea:bootstrap": "bash scripts/gitea-bootstrap.sh",
    "tunnel": "bash scripts/tunnel.sh",
    "tunnel:stop": "pkill -f 'cloudflared tunnel.*run' && echo 'Stopped tunnel connector.' || echo 'No tunnel connector running.'"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@vritti/commerce-permissions": "workspace:*",
    "@as-integrations/fastify": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@getbrevo/brevo": "^4.0.1",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.5",
    "@vritti/api-sdk": "^0.3.6",
    "argon2": "^0.41.1",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "5.7.4",
    "fastify-raw-body": "^5.0.0",
    "graphql": "^16.14.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@compodoc/compodoc": "^1.1.31",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-orm": "1.0.0-rc.3",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest"
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
