{
  "name": "commerce-service",
  "version": "0.0.1",
  "description": "Commerce microservice for Vritti Core platform",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:ssl": "USE_HTTPS=true nest start --watch",
    "dev:ssl:w": "cross-env USE_HTTPS=true nest start --watch",
    "debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint .",
    "db:generate": "drizzle-kit generate --name v$npm_package_version",
    "db:generate:custom": "drizzle-kit generate --custom --name",
    "db:migrate": "NODE_TLS_REJECT_UNAUTHORIZED=0 drizzle-kit migrate",
    "db:deploy": "node dist/db/migrate.js",
    "db:studio": "NODE_TLS_REJECT_UNAUTHORIZED=0 drizzle-kit studio",
    "db:generate:w": "npx dotenv-cli -- drizzle-kit generate --name v%npm_package_version%",
    "db:generate:custom:w": "npx dotenv-cli -- drizzle-kit generate --custom --name",
    "db:migrate:w": "npx dotenv-cli cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 -- drizzle-kit migrate",
    "db:studio:w": "npx dotenv-cli cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 -- drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@vritti/api-sdk": "^0.2.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "nats": "^2.29.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-orm": "1.0.0-rc.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
