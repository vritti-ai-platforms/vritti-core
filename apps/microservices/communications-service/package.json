{
  "name": "communications-service",
  "version": "0.0.1",
  "description": "Communications microservice for VAP platform",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "infisical run --path=/communications-service -- nest start",
    "dev": "infisical run --path=/communications-service -- nest start --watch",
    "dev:dev": "infisical run --env=dev-local --path=/communications-service -- nest start --watch",
    "dev:apw1": "infisical run --env=apw1-local --path=/communications-service -- nest start --watch",
    "debug": "infisical run --path=/communications-service -- nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:generate": "infisical run --path=/communications-service -- drizzle-kit generate --name v$npm_package_version",
    "db:generate:custom": "infisical run --path=/communications-service -- drizzle-kit generate --custom --name",
    "db:migrate": "infisical run --path=/communications-service -- drizzle-kit migrate",
    "db:migrate:dev": "infisical run --env=dev-local --path=/communications-service -- drizzle-kit migrate",
    "db:migrate:apw1": "infisical run --env=apw1-local --path=/communications-service -- drizzle-kit migrate",
    "db:grant": "infisical run --path=/communications-service -- node ../../../tools/run-sql.cjs init-db/01-grant-app-role.sql",
    "db:grant:dev": "infisical run --env=dev-local --path=/communications-service -- node ../../../tools/run-sql.cjs init-db/01-grant-app-role.sql",
    "db:grant:prod": "infisical run --env=apw1-local --path=/communications-service -- node ../../../tools/run-sql.cjs init-db/01-grant-app-role.sql",
    "db:deploy": "node dist/db/migrate.js",
    "db:studio": "infisical run --path=/communications-service -- drizzle-kit studio",
    "db:studio:dev": "infisical run --env=dev-local --path=/communications-service -- drizzle-kit studio",
    "db:studio:apw1": "infisical run --env=apw1-local --path=/communications-service -- drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@vritti/api-sdk": "0.4.3",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "nats": "^2.29.3",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-orm": "1.0.0-rc.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
