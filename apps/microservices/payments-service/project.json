{
  "name": "payments-service",
  "projectType": "application",
  "sourceRoot": "apps/microservices/payments-service/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "dev:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev:dev",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "dev:apw1": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev:apw1",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run start",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:generate",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:migrate",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:migrate:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:migrate:dev",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:migrate:apw1": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:migrate:apw1",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:grant": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:grant",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:grant:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:grant:dev",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:grant:prod": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:grant:prod",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:deploy",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run db:studio",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
