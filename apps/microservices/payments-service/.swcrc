{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2023",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./src/modules/domain/*"],
      "@/generated/*": ["./src/generated/*"],
      "@/db/*": ["./src/db/*"]
    }
  },
  "module": {
    "type": "commonjs"
  },
  "minify": false
}
