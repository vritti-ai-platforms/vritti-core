{
  "name": "commerce-ma",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "react-native start --config rspack.config.mjs --port 9002 --host 0.0.0.0",
    "build:ios": "react-native bundle --config rspack.config.mjs --platform ios --dev false",
    "build:android": "react-native bundle --config rspack.config.mjs --platform android --dev false",
    "build": "pnpm run build:ios && pnpm run build:android",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@vritti/commerce-permissions": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/elements": "3.0.0-alpha.20",
    "@react-navigation/native": "8.0.0-alpha.17",
    "@vritti/quantum-ui-native": "0.2.0",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.5.0",
    "graphql": "^16.14.2",
    "nativewind": "5.0.0-preview.3",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.2",
    "react-native-css": "3.0.6",
    "react-native-nitro-modules": "^0.35.3",
    "react-native-reanimated": "^4.3.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.11.2",
    "react-native-worklets": "0.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "4.2.2",
    "zeego": "^3.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@callstack/repack": "5.2.5",
    "@callstack/repack-plugin-reanimated": "^5.2.5",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "react-native-safe-area-context": "^5.7.0",
    "@rspack/core": "^1.7.11",
    "@swc/helpers": "^0.5.17",
    "@tailwindcss/postcss": "4.2.2",
    "@types/react": "~19.2.2",
    "babel-loader": "^9.2.1",
    "lightningcss": "1.30.1",
    "postcss-loader": "^8.2.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
