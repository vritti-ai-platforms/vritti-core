# APP_ENV — 'development' | 'production'
APP_ENV=development

# DEV_HOST — OPTIONAL. The dev host is detected from the bundle's origin at runtime, so this is
# only needed to point Module Federation at a different machine than the one serving the bundle.
# Host or IP only — no protocol, no port (e.g. 192.168.1.9).
# DEV_HOST=

# API_BASE_URL — full URL to the core API.
API_BASE_URL=
# DEPLOYMENTS_API_BASE_URL — full URL to the deployments API.
# Set separately because it may point at a shared dev server.
DEPLOYMENTS_API_BASE_URL=

# GRAPHQL_PATH — which GraphQL surface this app talks to.
# core-server serves two: /graphql (storefront, public schema) and /mobile-graphql (internal).
# This app is the internal consumer.
GRAPHQL_PATH=/mobile-graphql
