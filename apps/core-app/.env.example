# APP_ENV — 'development' | 'production'
APP_ENV=development

# DEV_HOST — your LAN IP or hostname (no protocol, no port). Required in development.
# All dev service URLs are derived from this host:
#   Deployments API    → DEPLOYMENTS_API_BASE_URL (set explicitly below — may differ)
#   Raw core server    → http://<DEV_HOST>:3001
#   Module Federation  → http://<DEV_HOST>:8081
DEV_HOST=

# DEPLOYMENTS_API_BASE_URL — full URL to the deployments API.
# Set separately because it may point at a shared dev server.
DEPLOYMENTS_API_BASE_URL=
