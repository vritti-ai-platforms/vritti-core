{
  "name": "vritti-core-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/core-app",
  "targets": {
    "start": {
      "command": "react-native webpack-start",
      "options": { "cwd": "{projectRoot}" }
    },
    "android": {
      "command": "react-native run-android",
      "options": { "cwd": "{projectRoot}" }
    },
    "ios": {
      "command": "react-native run-ios",
      "options": { "cwd": "{projectRoot}" }
    },
    "bundle:android": {
      "command": "react-native webpack-bundle --platform android --dev false --entry-file index.js --bundle-output ./build/index.android.bundle",
      "options": { "cwd": "{projectRoot}" }
    },
    "bundle:ios": {
      "command": "react-native webpack-bundle --platform ios --dev false --entry-file index.js --bundle-output ./build/index.ios.bundle",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint": {
      "command": "eslint .",
      "cache": true,
      "inputs": ["default"],
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
