{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["react-native", "@rspack/core/module"],
    "baseUrl": ".",
    "paths": {
      "@vritti/quantum-ui-native": ["../../../quantum-ui-native/dist/typescript/lib/index.d.ts"],
      "@vritti/quantum-ui-native/*": [
        "../../../quantum-ui-native/dist/typescript/lib/*",
        "../../../quantum-ui-native/dist/typescript/lib/components/*/index.d.ts"
      ],
      "react-native": ["../../node_modules/react-native"],
      "axios": ["../../node_modules/axios"],
      "react-hook-form": ["../../node_modules/react-hook-form"],
      "@tanstack/react-query": ["../../node_modules/@tanstack/react-query"],
      "@tanstack/query-core": ["../../node_modules/@tanstack/query-core"],
      "@react-navigation/native": ["../../node_modules/@react-navigation/native"],
      "react-native-reanimated": ["../../node_modules/react-native-reanimated"],
      "react-native-worklets": ["../../node_modules/react-native-worklets"],
      "@react-navigation/bottom-tabs": [
        "../../node_modules/@react-navigation/bottom-tabs",
        "../../../quantum-ui-native/node_modules/@react-navigation/bottom-tabs"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["node_modules"]
}
