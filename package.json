{
  "name": "vritti-core",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nx run-many --target=dev:ssl --projects=vritti-core-server,vritti-core-web,commerce-service,commerce-mf --parallel=5 --output-style=stream",
    "dev:server": "nx run vritti-core-server:dev:ssl",
    "dev:web": "nx run vritti-core-web:dev:ssl",
    "dev:commerce-service": "nx run commerce-service:dev:ssl",
    "dev:commerce-mf": "nx run commerce-mf:dev:ssl",
    "dev:app": "pnpm --filter vritti-core-app start",
    "dev:app:android": "pnpm --filter vritti-core-app android",
    "dev:app:ios": "pnpm --filter vritti-core-app ios",
    "dev:native:host": "pnpm --filter vritti-core-app start",
    "dev:native:commerce": "pnpm --filter vritti-core-app start:commerce",
    "dev:native:ios": "pnpm --filter vritti-core-app ios",
    "dev:native:android": "pnpm --filter vritti-core-app android",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:e2e": "nx run-many --target=e2e --all",
    "check": "nx run-many --target=check --all",
    "graph": "nx graph",
    "release": "nx release",
    "db:generate": "nx run vritti-core-server:db:generate",
    "db:push": "nx run vritti-core-server:db:push",
    "db:migrate": "nx run vritti-core-server:db:migrate",
    "db:studio": "nx run vritti-core-server:db:studio",
    "db:reset": "nx run vritti-core-server:db:reset",
    "db:drop": "nx run vritti-core-server:db:drop",
    "db:start": "nx run vritti-core-server:db:start",
    "db:stop": "nx run vritti-core-server:db:stop",
    "db:generate:w": "nx run vritti-core-server:db:generate:w",
    "db:push:w": "nx run vritti-core-server:db:push:w",
    "db:migrate:w": "nx run vritti-core-server:db:migrate:w",
    "db:studio:w": "nx run vritti-core-server:db:studio:w",
    "db:reset:w": "nx run vritti-core-server:db:reset:w"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@nx/js": "^20.8.4",
    "nx": "^20.0.0"
  }
}
