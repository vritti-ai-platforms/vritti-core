{
  "name": "vritti-core",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build:permissions": "pnpm --filter @vritti/commerce-permissions build",
    "dev": "pnpm build:permissions && nx run-many --target=dev --projects=vritti-core-server,vritti-core-web,commerce-service,commerce-mf --parallel=5 --output-style=stream",
    "dev:ssl": "pnpm build:permissions && nx run-many --target=dev:ssl --projects=vritti-core-server,vritti-core-web,commerce-service,commerce-mf --parallel=5 --output-style=stream",
    "dev:ssl:vm": "pnpm build:permissions && nx run-many --target=dev:ssl:vm --projects=vritti-core-server,vritti-core-web,commerce-service,commerce-mf --parallel=5 --output-style=stream",
    "dev:server": "nx run vritti-core-server:dev",
    "dev:server:ssl": "nx run vritti-core-server:dev:ssl",
    "dev:web": "nx run vritti-core-web:dev",
    "dev:commerce-service": "nx run commerce-service:dev:ssl",
    "dev:commerce-mf": "nx run commerce-mf:dev",
    "dev:app": "pnpm --filter vritti-core-app start",
    "dev:app:ios": "pnpm --filter vritti-core-app ios",
    "dev:app:android": "pnpm --filter vritti-core-app android",
    "dev:mfs": "pnpm --filter \"./apps/micro-apps/*\" --parallel start",
    "dev:mf:commerce": "pnpm --filter commerce-ma start",
    "dev:w": "nx run-many --target=dev:ssl:w --projects=vritti-core-server,vritti-core-web,commerce-service,commerce-mf --parallel=5 --output-style=stream",
    "build": "nx run-many --target=build --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:e2e": "nx run-many --target=e2e --all",
    "check": "nx run-many --target=check --all",
    "graph": "nx graph",
    "release": "nx release",
    "db:generate": "nx run vritti-core-server:db:generate && nx run commerce-service:db:generate",
    "db:migrate": "nx run vritti-core-server:db:migrate && nx run commerce-service:db:migrate",
    "db:deploy": "nx run vritti-core-server:db:deploy && nx run commerce-service:db:deploy",
    "db:studio": "nx run vritti-core-server:db:studio",
    "db:start": "nx run vritti-core-server:db:start",
    "db:stop": "nx run vritti-core-server:db:stop",
    "db:generate:w": "nx run vritti-core-server:db:generate:w && nx run commerce-service:db:generate:w",
    "db:migrate:w": "nx run vritti-core-server:db:migrate:w && nx run commerce-service:db:migrate:w",
    "db:studio:w": "nx run vritti-core-server:db:studio:w",
    "db:generate:win": "cross-env-shell \"nx run vritti-core-server:db:generate && nx run commerce-service:db:generate\"",
    "db:migrate:win": "cross-env-shell \"nx run vritti-core-server:db:migrate && nx run commerce-service:db:migrate\"",
    "db:studio:win": "cross-env-shell nx run vritti-core-server:db:studio",
    "db:start:win": "cross-env-shell nx run vritti-core-server:db:start",
    "db:stop:win": "cross-env-shell nx run vritti-core-server:db:stop",
    "db:generate:w:win": "cross-env-shell \"nx run vritti-core-server:db:generate:w && nx run commerce-service:db:generate:w\"",
    "db:migrate:w:win": "cross-env-shell \"nx run vritti-core-server:db:migrate:w && nx run commerce-service:db:migrate:w\"",
    "db:studio:w:win": "cross-env-shell nx run vritti-core-server:db:studio:w"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@nx/js": "^20.8.4",
    "nx": "^20.0.0"
  }
}
