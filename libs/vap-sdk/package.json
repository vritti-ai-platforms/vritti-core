{
  "name": "@vritti/vap-sdk",
  "description": "Client for the VAP API \u2014 signed requests, identity today, orders and appointments as they land",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.6-alpha.17",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vritti-ai-platforms/vritti-core.git",
    "directory": "libs/vap-sdk"
  },
  "homepage": "https://github.com/vritti-ai-platforms/vritti-core/tree/main/libs/vap-sdk#readme",
  "bugs": {
    "url": "https://github.com/vritti-ai-platforms/vritti-core/issues"
  },
  "keywords": [
    "vritti",
    "sdk",
    "api-client",
    "signed-requests",
    "typescript"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./money": {
      "types": "./dist/core/money.d.ts",
      "default": "./dist/core/money.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./payload": {
      "types": "./dist/payload/index.d.ts",
      "default": "./dist/payload/index.js"
    },
    "./payload/client": {
      "types": "./dist/payload/client/index.d.ts",
      "default": "./dist/payload/client/index.js"
    },
    "./checkout": {
      "types": "./dist/checkout/index.d.ts",
      "default": "./dist/checkout/index.js"
    },
    "./razorpay": {
      "types": "./dist/checkout/razorpay.d.ts",
      "default": "./dist/checkout/razorpay.js"
    },
    "./hdfc": {
      "types": "./dist/checkout/hdfc.d.ts",
      "default": "./dist/checkout/hdfc.js"
    },
    "./cashfree": {
      "types": "./dist/checkout/cashfree.d.ts",
      "default": "./dist/checkout/cashfree.js"
    },
    "./easebuzz": {
      "types": "./dist/checkout/easebuzz.d.ts",
      "default": "./dist/checkout/easebuzz.js"
    },
    "./next/auth": {
      "types": "./dist/next/auth.d.ts",
      "default": "./dist/next/auth.js"
    },
    "./next/cart": {
      "types": "./dist/next/cart.d.ts",
      "default": "./dist/next/cart.js"
    },
    "./next/payments": {
      "types": "./dist/next/payments.d.ts",
      "default": "./dist/next/payments.js"
    },
    "./next/checkout": {
      "types": "./dist/next/checkout.d.ts",
      "default": "./dist/next/checkout.js"
    },
    "./next/wishlist": {
      "types": "./dist/next/wishlist.d.ts",
      "default": "./dist/next/wishlist.js"
    },
    "./next/account": {
      "types": "./dist/next/account.d.ts",
      "default": "./dist/next/account.js"
    },
    "./next/party": {
      "types": "./dist/next/party.d.ts",
      "default": "./dist/next/party.js"
    },
    "./next/workspace": {
      "types": "./dist/next/workspace.d.ts",
      "default": "./dist/next/workspace.js"
    },
    "./next/middleware": {
      "types": "./dist/next/middleware.d.ts",
      "default": "./dist/next/middleware.js"
    },
    "./next/checkout-ui": {
      "types": "./dist/next/checkout-ui/index.d.ts",
      "default": "./dist/next/checkout-ui/index.js"
    },
    "./next/checkout-ui/client": {
      "types": "./dist/next/checkout-ui/client.d.ts",
      "default": "./dist/next/checkout-ui/client.js"
    },
    "./next/checkout-ui.css": "./dist/next/checkout-ui/checkout-ui.css",
    "./next/checkout-card": {
      "types": "./dist/next/checkout-ui/card.d.ts",
      "default": "./dist/next/checkout-ui/card.js"
    },
    "./next/checkout-card.css": "./dist/next/checkout-ui/checkout-card.css",
    "./next/core-boundary": {
      "types": "./dist/next/core-boundary.d.ts",
      "default": "./dist/next/core-boundary.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm codegen && pnpm check:tiers && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.next.json && node scripts/build-checkout-css.mjs && node scripts/check-bundle-size.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "clean": "rm -rf dist src/core/gql",
    "check:tiers": "node scripts/check-tiers.mjs",
    "test": "jest",
    "check:size": "node scripts/check-bundle-size.mjs --report"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.5.2",
    "next": "16.2.6",
    "payload": "^3.93.0",
    "postcss": "^8.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@apollo/client": "^4.3.7",
    "@tanstack/react-query": "5.104.0",
    "@vritti/quantum-ui": "0.6.4",
    "decimal.js": "^10.6.0",
    "dinero.js": "^2.0.2",
    "graphql": "^16.15.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.562.0",
    "react-hook-form": "7.87.0"
  },
  "peerDependencies": {
    "next": "^15 || ^16",
    "payload": "^3",
    "pg": "^8",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": "\\.test\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@vritti/vap-sdk$": "<rootDir>/core/index.ts",
      "^@vritti/vap-sdk/(checkout)$": "<rootDir>/checkout/index.ts",
      "^@vritti/vap-sdk/(razorpay|hdfc|cashfree|easebuzz)$": "<rootDir>/checkout/$1.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest"
      ]
    }
  }
}
