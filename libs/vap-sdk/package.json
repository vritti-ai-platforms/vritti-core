{
  "name": "@vritti/vap-sdk",
  "description": "Client for the VAP API — signed requests, identity today, orders and appointments as they land",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.3",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vritti-ai-platforms/vritti-core.git",
    "directory": "libs/vap-sdk"
  },
  "homepage": "https://github.com/vritti-ai-platforms/vritti-core/tree/main/libs/vap-sdk#readme",
  "bugs": {
    "url": "https://github.com/vritti-ai-platforms/vritti-core/issues"
  },
  "keywords": [
    "vritti",
    "sdk",
    "api-client",
    "signed-requests",
    "typescript"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./payload": {
      "types": "./dist/payload/index.d.ts",
      "default": "./dist/payload/index.js"
    },
    "./payload/client": {
      "types": "./dist/payload/client/index.d.ts",
      "default": "./dist/payload/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm codegen && pnpm check:tiers && tsc -p tsconfig.json && tsc -p tsconfig.client.json && node -e \"require('fs').writeFileSync('dist/payload/client/package.json', JSON.stringify({type:'module'}))\"",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "clean": "rm -rf dist src/core/gql",
    "check:tiers": "node scripts/check-tiers.mjs"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "payload": "^3.86.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "graphql": "^16.14.2",
    "libphonenumber-js": "^1.13.12"
  },
  "peerDependencies": {
    "payload": "^3",
    "pg": "^8",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
