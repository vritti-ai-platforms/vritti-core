{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // Node16 rather than the classic "Node" resolution commerce-permissions
    // uses: this package imports `@vritti/api-sdk/signing`, and only the newer
    // algorithms read a package's `exports` map. With no "type": "module" in
    // package.json the emit is still CommonJS, and api-sdk publishes a
    // `require` condition for every subpath.
    "module": "Node16",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
