{
  "model": "claude-opus-4-7",
  "max_tokens": 1000,
  "enabledPlugins": {
    "vritti-dev-tools@vritti-plugins": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "vritti-plugins": {
      "source": {
        "source": "github",
        "repo": "vritti-ai-platforms/vritti-plugins"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/native-guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/native-postedit.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/validate-conventions.sh\""
          }
        ]
      }
    ]
  }
}
